do_fetch() {
	echo "DO_FETCH START"
	pwd
	echo "about to clone into ${pkgname}-${version}"
# 	git clone --depth 1 --branch gittyup_v${version} --recursive https://github.com/Murmele/Gittyup.git ${pkgname}-${version}
# 	halt
	echo "DO_FETCH END"
}

