do_fetch(){
	git clone --depth 1 --branch gittyup_v${version} --recursive https://github.com/Murmele/Gittyup.git
}

post_extract(){
	echo "POST_EXTRACT START"
# 	rm -rf ./dep
	echo "POST_EXTRACT DONE"
}

do_configure(){
	echo "DO_CONFIGURE START"
cd dep/openssl/openssl
./config -fPIC
make
	echo "DO_CONFIGURE DONE"
}

do_build() {
	echo "DO_BUILD START"
# Start from root of gittyup repo.
mkdir -p build/release
cd build/release
cmake -G Ninja -DCMAKE_BUILD_TYPE=Release ../..
ninja
	echo "SUCCESS do build"
	echo "DO_BUILD DONE"
}

