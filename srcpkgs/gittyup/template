do_configure() {
	echo "DO_CONFIGURE START"
	pwd
	cd dep/openssl/openssl
	echo ${wrksrc}/dep/openssl/openssl
	./config -fPIC
	make
	echo "DO_CONFIGURE DONE"
}

do_build() {
	echo "DO_BUILD START"
# Start from root of gittyup repo.
mkdir -p build/release
cd build/release
cmake -G Ninja -DCMAKE_BUILD_TYPE=Release ../..
ninja
	echo "SUCCESS do build"
	echo "DO_BUILD DONE"
}

